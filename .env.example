# Vita-Gap Environment Configuration

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vitagap
DB_USER=vitagap_user
DB_PASS=vitagap_secret
DB_CHARSET=utf8mb4

# Versions
ENGINE_VERSION=1.0.0
KB_VERSION=1.0.0

# Security & Limits
RATE_LIMIT_HOURLY=60
MAX_UPLOAD_BYTES=5242880
MAX_INPUT_LINES=50000
SALT_SECRET=change_me_to_a_random_32_byte_secret_hex
